# fp-int-agents root endpoint configuration template
# Copy this file to config.toml at the project root and fill in your values.
# config.toml is gitignored — never commit secrets.

[llm]
# Example: Local Ollama
# base_url = "http://localhost:11434/v1"
# api_key = "ollama"

# Example: LiteLLM or OpenAI-compatible proxy
base_url = "http://localhost:4000/v1"
api_key = "none"

[reranker]
url = "http://127.0.0.1:8001/v1/rerank"