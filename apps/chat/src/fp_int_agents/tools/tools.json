[
  {
    "name": "get_weather",
    "description": "Get the current weather for a given location.",
    "command": "uv run scripts/get_weather.py",
    "parameters": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "description": "City name, e.g. 'Berlin'"
        },
        "units": {
          "type": "string",
          "enum": ["celsius", "fahrenheit"],
          "description": "Temperature unit"
        }
      },
      "required": ["location"]
    }
  }
]
